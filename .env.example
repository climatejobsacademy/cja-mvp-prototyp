# Aus den API-Einstellungen des Supabase-Projekts (Project Settings > API).
# Ohne diese zwei Variablen startet die App nicht (auch /login nicht) — siehe
# README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Für den Magic-Link-Redirect (login/actions.ts). Lokal http://localhost:3000,
# in Produktion die echte Domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nur für scripts/invite-learner.mjs (SR-49) -- niemals im App-Code
# verwenden, niemals committen. Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
