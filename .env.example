# Aus den API-Einstellungen des Supabase-Projekts (Project Settings > API).
# Ohne diese zwei Variablen startet die App nicht (auch /login nicht) — siehe
# README.md.
# Lokal: Werte aus `supabase start` oder aus Staging (Supabase Irland,
# https://keijrwvegmwgpvprpoxa.supabase.co). Production (Frankfurt,
# vqfnmkcfjsudsujiuoqm) nur zur Dokumentation genannt -- nicht hier eintragen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Für den Magic-Link-Redirect (login/actions.ts). Lokal http://localhost:3000,
# in Produktion die echte Domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nur für scripts/invite-learner.mjs --target=staging (SR-49) -- niemals im
# App-Code verwenden, niemals committen. Staging-Projekt: Project Settings >
# API Keys > Legacy > service_role. Production liest den Key nur aus dem
# Schlüsselbund (cja-fra-service-role), nie aus dieser Datei.
SUPABASE_SERVICE_ROLE_KEY=
